{
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "string_decoder": [
        "./node_modules/@types/node/string_decoder.d.ts"
      ]
    }
  },
  "include": [
    "bin",
    "src",
    "test",
    "types.d.ts",
    "node_modules/@flancer32",
    "node_modules/@teqfw",
    "src/**/*.mjs",
    "test/**/*.mjs"
  ],
  "exclude": [
    "ctx"
  ]
}
