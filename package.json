{
  "name": "@teqfw/dem",
  "version": "0.3.0",
  "description": "Domain Entity Model: logical schema compilation and portable entity repository contracts for TeqFW applications.",
  "type": "module",
  "files": [
    "conformance/",
    "etc/",
    "skills/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "types.d.ts"
  ],
  "scripts": {
    "test": "npm run check:esm && find test/unit test/integration test/package test/docs -name \"*.test.mjs\" -print0 | xargs -0 node --test",
    "typecheck": "tsc -p jsconfig.json",
    "verify": "npm test",
    "prepublishOnly": "npm run verify",
    "test:browser": "node --test test/browser/Runtime.test.mjs test/browser/Delivery.test.mjs",
    "check:esm": "teqfw-esm-validator src --profile base"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/dem.git"
  },
  "keywords": [
    "teqfw",
    "data-model",
    "dem",
    "esm",
    "tequila framework"
  ],
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts"
    },
    "./etc/dem-schema.json": "./etc/dem-schema.json",
    "./conformance": "./conformance/Repository.mjs",
    "./conformance/values": "./conformance/Values.mjs",
    "./conformance/application": "./conformance/application/Workflow.mjs",
    "./conformance/application/schema": "./conformance/application/Schema.mjs"
  },
  "bugs": {
    "url": "https://github.com/teqfw/dem/issues"
  },
  "homepage": "https://github.com/teqfw/dem#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@teqfw/di": "^2.11.0"
  },
  "devDependencies": {
    "@teqfw/dem-idb": "github:teqfw/dem-idb",
    "@teqfw/dem-rdb": "github:teqfw/dem-rdb",
    "@teqfw/web": "^2.2.0",
    "@types/node": "^22.20.5",
    "knex": "^3.1.0",
    "sqlite3": "^6.0.1",
    "typescript": "^5.9.3",
    "@flancer32/skill-teqfw-esm-validator": "^0.15.2"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Dem_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    }
  },
  "dependencies": {
    "@teqfw/cli": "^2.5.0"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
