{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "baseUrl": ".",
    "paths": {
      "string_decoder": ["./node_modules/@types/node/string_decoder.d.ts"]
    },
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.mjs",
    "test/**/*.mjs",
    "types.d.ts",
    "node_modules/@teqfw/di/types.d.ts",
    "node_modules/@teqfw/di/src",
    "node_modules/@teqfw/cfg/types.d.ts",
    "node_modules/@teqfw/log/types.d.ts",
    "node_modules/@teqfw/web/types.d.ts",
    "conformance/application/*.mjs"
  ],
  "exclude": [
    "ctx"
  ]
}
