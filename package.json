{
  "name": "@teqfw/dem",
  "version": "0.2.0",
  "description": "Domain Entity Model: compose and validate plugin schema fragments into a complete logical data model for TeqFW applications.",
  "type": "module",
  "files": [
    "skills/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "types.d.ts"
  ],
  "scripts": {
    "test": "find test/unit test/integration test/package test/docs -name \"*.test.mjs\" -print0 | xargs -0 node --test",
    "typecheck": "tsc -p jsconfig.json",
    "verify": "npm test && npm run typecheck",
    "prepublishOnly": "npm run verify",
    "test:browser": "node --test test/browser/Runtime.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/dem.git"
  },
  "keywords": [
    "teqfw",
    "data-model",
    "dem",
    "esm",
    "tequila framework"
  ],
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts"
    }
  },
  "bugs": {
    "url": "https://github.com/teqfw/dem/issues"
  },
  "homepage": "https://github.com/teqfw/dem#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@teqfw/di": "^2.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Dem_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    }
  }
}
