{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "types": [
      "node"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.mjs",
    "test/**/*.mjs",
    "types.d.ts",
    "node_modules/@teqfw/di/types.d.ts",
    "node_modules/@teqfw/di/src"
  ],
  "exclude": [
    "ctx"
  ]
}
