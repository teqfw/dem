{
  "compilerOptions": {
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "string_decoder": ["./node_modules/@types/node/string_decoder.d.ts"]
    }
  },
  "include": ["types.d.ts", "node_modules/@teqfw", "src/**/*.mjs", "test/**/*.mjs"],
  "exclude": [
    "ctx",
    "node_modules/@teqfw/**/*.js"
  ]
}
